    "version": "0.2.0",
    "configurations": [
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Run Portfolio (localhost:8080)",
            "url": "http://localhost:8080/index.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start local server (8080)"
        },
        {
            "type": "pwa-msedge",
            "request": "launch",
            "name": "Run Portfolio in Edge (localhost:8080)",
            "url": "http://localhost:8080/index.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start local server (8080)"
        }
    ]
}